# ─── Azure Voice Live API (STT + TTS endpoint) ──────────────────────────────
AZURE_VOICE_LIVE_ENDPOINT=https://<your-voice-live-foundry>.services.ai.azure.com
AZURE_VOICE_LIVE_API_KEY=<your-api-key>
VOICE_LIVE_MODEL=gpt-4.1-mini

# ─── BYO LLM (optional — use when LLM is on a different Foundry resource) ───
# Deployment Modes:
#   Default mode: Model deployed on the same Foundry as Voice Live.
#                 Leave BYOM_PROFILE and FOUNDRY_RESOURCE_OVERRIDE empty.
#   BYOM mode:    Model on a separate Foundry resource (e.g., different region).
#                 Set both BYOM_PROFILE and FOUNDRY_RESOURCE_OVERRIDE.
#
# Profiles: byom-azure-openai-chat-completion | byom-azure-openai-realtime
#            byom-foundry-anthropic-messages | "" (managed, default)
# Example: Voice Live on Central India, LLM on South India
#   BYOM_PROFILE=byom-azure-openai-chat-completion
#   FOUNDRY_RESOURCE_OVERRIDE=https://<your-llm-foundry>.services.ai.azure.com
BYOM_PROFILE=
FOUNDRY_RESOURCE_OVERRIDE=

# ─── Azure Managed Identity (for Container Apps / App Service) ───────────────
AZURE_USER_ASSIGNED_IDENTITY_CLIENT_ID=

# ─── App Settings ────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ─── Call termination ────────────────────────────────────────────────────────
# Hang up automatically if the customer stays silent this many seconds.
IDLE_TIMEOUT_SECONDS=60

# ─── Human escalation / hand-off email ───────────────────────────────────────
# Where escalation + resolved-handoff summaries are e-mailed (the "human agent").
ESCALATION_EMAIL=XXXXX@microsoft.com

# Delivery backend priority: ACS → SMTP → simulated outbox (server/outbox/).
#
# ── Azure Communication Services (recommended for production) ──
# Set ACS_EMAIL_SENDER plus EITHER a connection string OR an endpoint (the
# latter uses Managed Identity / Azure CLI credential). Create an Email
# Communication Services resource + verified domain first; the sender must be a
# verified MailFrom address (Azure-managed looks like DoNotReply@<guid>.azurecomm.net).
ACS_EMAIL_SENDER=
ACS_EMAIL_CONNECTION_STRING=
ACS_EMAIL_ENDPOINT=

# ── SMTP (fallback) ──
# If ACS is not configured and SMTP_HOST is empty, escalation emails are
# simulated — written to server/outbox/ and logged (no real mail sent). Set
# these to send real email. Do NOT commit real credentials; keep them local.
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
