# ── Audio synthesis (Azure Speech via Microsoft Entra — NO API KEY) ──────────
# synthesize_audio.py authenticates with DefaultAzureCredential (az login locally,
# or managed identity in Azure). The identity needs "Cognitive Services User" on the
# resource. Use an AIServices resource's full ARM id (custom subdomain is required
# for AAD token auth). No key is stored.
SPEECH_RESOURCE_ID=/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<account>
SPEECH_REGION=swedencentral
# Optional: override the customer TTS voice (default hi-IN-SwaraNeural)
# CUSTOMER_TTS_VOICE=hi-IN-SwaraNeural

# ── Voice Live evaluation harness — Microsoft Entra auth (DefaultAzureCredential) ──
# No keys. Identity needs Cognitive Services User on the Voice Live resource and
# Azure AI User on the Foundry project.
AZURE_VOICELIVE_ENDPOINT=wss://<your-resource>.services.ai.azure.com
AZURE_VOICELIVE_MODEL=gpt-realtime
# Foundry project endpoint that runs the evaluators (required for scoring).
PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>
# Azure OpenAI GPT deployment the evaluators use as the judge (e.g. gpt-5-mini).
AOAI_DEPLOYMENT_NAME=gpt-5-mini
